        echo 2\
'", SYMLINK+="com%c"

KERNEL=="ttyAMA2", PROGRAM="/bin/sh -c '\
        echo 3\
'", SYMLINK+="com%c"

KERNEL=="ttyAMA4", PROGRAM="/bin/sh -c '\
        echo 4\
'", SYMLINK+="com%c"
