KERNEL=="ttysWK*", ACTION=="add", PROGRAM="/bin/sh -c 'chgrp -R dialout /dev/%k && chmod -R g=u /dev/%k'"

KERNEL=="ttyAMA0", PROGRAM="/bin/sh -c 'echo 0'", SYMLINK+="com%c"

KERNEL=="ttyAMA1", PROGRAM="/bin/sh -c 'echo 1'", SYMLINK+="com%c"

KERNEL=="ttyAMA2", PROGRAM="/bin/sh -c 'echo 2'", SYMLINK+="com%c"

KERNEL=="ttysWK0", PROGRAM="/bin/sh -c 'echo 3'", SYMLINK+="com%c"

KERNEL=="ttysWK1", PROGRAM="/bin/sh -c 'echo 4'", SYMLINK+="com%c"

KERNEL=="ttysWK2", PROGRAM="/bin/sh -c 'echo 5'", SYMLINK+="com%c"

KERNEL=="ttysWK3", PROGRAM="/bin/sh -c 'echo 6'", SYMLINK+="com%c"

KERNEL=="ttyAMA3", PROGRAM="/bin/sh -c 'echo 1'", SYMLINK+="rs485_%c"

KERNEL=="ttyAMA4", PROGRAM="/bin/sh -c 'echo 2'", SYMLINK+="rs485_%c"
